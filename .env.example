# ==========================================================
# CARE Accommodation Management System (CAMS) - Backend
# Copy this file to .env and fill in real values.
# ==========================================================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/care_dadaab_accommodation

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
MFA_ISSUER=CAMS CARE Dadaab

# CORS (comma separated list of allowed origins, or * for all)
CORS_ORIGIN=*

# Email (Nodemailer SMTP)
# Booking confirmations are sent to the visitor email and the booking officer
# when notifications.sendBookingConfirmation is enabled in Settings.
# For STARTTLS use port 587 and SMTP_SECURE=false.
# For implicit TLS use port 465 and SMTP_SECURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=CARE Kenya Dadaab Accommodation
EMAIL_FROM_ADDRESS=no-reply@example.com

# Organisation / Support
SUPPORT_EMAIL=accommodation.dadaab@care.org
SUPPORT_PHONE=+254700000000
ADMIN_PANEL_URL=https://care-dadaab-booking-frontend.onrender.com/admin/bookings.html

# Booking reference
BOOKING_REFERENCE_PREFIX=CARE

# Safaricom Daraja C2B Paybill reconciliation
# Use the booking reference as the Paybill account number.
# Production Daraja configuration
DARAJA_ENABLED=true
DARAJA_ENVIRONMENT=production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_C2B_SHORT_CODE=123456
DARAJA_STK_SHORT_CODE=123456
DARAJA_PASSKEY=
# Public HTTPS origin, for example https://api.example.org
DARAJA_CALLBACK_BASE_URL=
DARAJA_VALIDATION_PATH=/api/v1/payments/c2b/validation
DARAJA_CONFIRMATION_PATH=/api/v1/payments/c2b/confirmation
DARAJA_STK_CALLBACK_PATH=/api/v1/payments/stk/callback
