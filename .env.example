# ==========================================================
# CARE Accommodation Management System (CAMS) - Backend
# Copy this file to .env and fill in real values.
# ==========================================================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/care_dadaab_accommodation

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# CORS (comma separated list of allowed origins, or * for all)
CORS_ORIGIN=*

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=CARE Kenya Dadaab Accommodation
EMAIL_FROM_ADDRESS=no-reply@example.com

# Organisation / Support
SUPPORT_EMAIL=accommodation.dadaab@care.org
SUPPORT_PHONE=+254700000000

# Booking reference
BOOKING_REFERENCE_PREFIX=CARE
